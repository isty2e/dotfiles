__pycache__/
/config/shell/lib/device/
/workspaces/pixi-base/*
!/workspaces/pixi-base/pixi.toml
/workspaces/daem/*
!/workspaces/daem/daem.toml
**/lazy-lock.json
/workspaces/mise/*
!/workspaces/mise/config.toml
!/workspaces/mise/conf.d/
/workspaces/mise/conf.d/*
!/workspaces/mise/conf.d/tools.toml
/workspaces/sheldon/*
!/workspaces/sheldon/plugins.toml
/mise.local.toml
/mise.lock

# Preserve exclusions for local state left behind by the workspace migration.
/home/pixi-env/base/.pixi/
/home/pixi-env/base/pixi.lock
/home/private_dot_config/private_daem/daem.lock.toml
/home/private_dot_config/private_daem/.daem/
