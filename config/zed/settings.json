{
  "cli_default_open_behavior": "existing_window",
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "preview_tabs": {
    "enable_preview_from_file_finder": true
  },
  "restore_on_startup": "last_session",
  "edit_predictions": {
    "provider": "copilot"
  },
  "icon_theme": "Catppuccin Latte",
  "text_rendering_mode": "platform_default",
  "show_whitespaces": "boundary",
  "vim": {
    "use_smartcase_find": true
  },
  "toolbar": {
    "code_actions": true
  },
  "use_smartcase_search": true,
  "use_system_window_tabs": true,
  "tab_bar": {
    "show_pinned_tabs_in_separate_row": false
  },
  "tabs": {
    "show_diagnostics": "errors",
    "close_position": "left",
    "file_icons": true,
    "git_status": true
  },
  "title_bar": {
    "show_branch_status_icon": true,
    "show_menus": false
  },
  "git_panel": {
    "dock": "left",
    "tree_view": true
  },
  "project_panel": {
    "dock": "left",
    "auto_fold_dirs": false
  },
  "context_server_timeout": 120,
  "agent_servers": {
    "opencode": {
      "type": "registry"
    },
    "github-copilot": {
      "type": "registry"
    }
  },
  "agent": {
    "sidebar_side": "right",
    "dock": "right",
    "profiles": {
      "ask": {
        "name": "Ask",
        "tools": {
          "diagnostics": true,
          "fetch": true,
          "list_directory": true,
          "now": true,
          "find_path": true,
          "read_file": true,
          "grep": true,
          "thinking": true
        },
        "enable_all_context_servers": false,
        "context_servers": {}
      }
    },
    "default_profile": "ask",
    "default_model": {
      "provider": "copilot_chat",
      "model": "claude-sonnet-4"
    }
  },
  "theme": "PaperColor Light",
  "helix_mode": true,
  "vim_mode": true,
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "tab_size": 2,
  "ui_font_size": 16,
  "buffer_font_size": 16,
  "buffer_font_family": "FiraCode Nerd Font",
  "ui_font_family": "FiraCode Nerd Font",
  "languages": {
    "Python": {
      "format_on_save": "on",
      "formatter": [
        {
          "language_server": {
            "name": "ruff"
          }
        }
      ],
      "language_servers": [
        "pyrefly",
        "!pyright",
        "ruff"
      ],
      "tab_size": 4,
      "wrap_guides": [
        88,
        120
      ]
    },
    "Ruby": {
      "formatter": {
        "external": {
          "command": "standardrb",
          "arguments": [
            "--fix",
            "--stdin",
            "ignored",
            "--stderr"
          ]
        }
      },
      "language_servers": [
        "ruby-lsp",
        "!rubocop"
      ]
    },
    "C": {
      "tab_size": 2
    },
    "C++": {
      "tab_size": 2
    },
    "Rust": {
      "tab_size": 4
    }
  },
  "file_scan_exclusions": [
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/.jj",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.settings",
    "**/.pixi"
  ],
  "soft_wrap": "editor_width"
}
