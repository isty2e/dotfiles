{{- $feature := include ".chezmoitemplates/claude-no-agent-summary/manifest.toml" | fromToml -}}
_dotfiles_claude_summary_env() {
    local hook="$HOME/.local/share/no-agent-summary.js"
    local preload="--preload=$hook"
    local original="${BUN_OPTIONS-}" option pending= seen=0 enabled=0
    local -a options=()
{{ if eq $feature.enabled true }}
    [[ -r $hook ]] && enabled=1
{{ end }}
    # Preserve unrelated token quoting; decode only to identify our preload.
    for option in "${(@z)original}"; do
        [[ -z $option ]] && continue
        if [[ -n $pending ]]; then
            if [[ ${(Q)option} == "$hook" ]]; then
                if (( enabled && !seen )); then
                    options+=("${(qqq)preload}")
                    seen=1
                fi
            else
                options+=("$pending" "$option")
            fi
            pending=
            continue
        fi
        if [[ ${(Q)option} == --preload ]]; then
            pending=$option
            continue
        fi
        if [[ ${(Q)option} == "--preload=$hook" ]]; then
            if (( enabled && !seen )); then
                options+=("${(qqq)preload}")
                seen=1
            fi
        else
            options+=("$option")
        fi
    done

    [[ -n $pending ]] && options+=("$pending")
    if (( enabled && !seen )); then
        # Bun parses quotes around the whole option, not shell backslash escapes.
        options+=("${(qqq)preload}")
    fi
    if (( $#options )); then
        export BUN_OPTIONS="${(j: :)options}"
    else
        unset BUN_OPTIONS
    fi
}
_dotfiles_claude_summary_env
unfunction _dotfiles_claude_summary_env
