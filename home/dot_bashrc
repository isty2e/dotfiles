# Fragments are optional deployed files, not paths beside this source file.
# shellcheck disable=SC1091

# Scripts and jobs must not enter the interactive profile.
case $- in *i*) ;; *) return 0 ;; esac
_dotfiles_shell_dir="$HOME/.config/dotfiles/shell"

# Handoff precedes profile setup so the final shell loads device code only once.
if [ -r "$_dotfiles_shell_dir/bash/handoff.sh" ]; then
    . "$_dotfiles_shell_dir/bash/handoff.sh"
fi

# OS defaults, then this device's overrides.
if [ -r "$_dotfiles_shell_dir/platform.sh" ]; then . "$_dotfiles_shell_dir/platform.sh"; fi
if [ -r "$_dotfiles_shell_dir/device.sh" ]; then . "$_dotfiles_shell_dir/device.sh"; fi

# Shared preferences and existing tools; none of these installs software.
if [ -r "$_dotfiles_shell_dir/generation.sh" ]; then . "$_dotfiles_shell_dir/generation.sh"; fi
if [ -r "$_dotfiles_shell_dir/integrations/homebrew.sh" ]; then . "$_dotfiles_shell_dir/integrations/homebrew.sh"; fi
if [ -r "$_dotfiles_shell_dir/preferences.sh" ]; then . "$_dotfiles_shell_dir/preferences.sh"; fi
if [ -r "$_dotfiles_shell_dir/integrations/slurm.sh" ]; then . "$_dotfiles_shell_dir/integrations/slurm.sh"; fi
if [ -r "$_dotfiles_shell_dir/integrations/environment.sh" ]; then . "$_dotfiles_shell_dir/integrations/environment.sh"; fi

# Native Bash features, then the final prompt.
if [ -r "$_dotfiles_shell_dir/bash/history.sh" ]; then . "$_dotfiles_shell_dir/bash/history.sh"; fi
if [ -r "$_dotfiles_shell_dir/bash/completion.sh" ]; then . "$_dotfiles_shell_dir/bash/completion.sh"; fi
if [ -r "$_dotfiles_shell_dir/integrations/prompt.sh" ]; then . "$_dotfiles_shell_dir/integrations/prompt.sh"; fi
unset _dotfiles_shell_dir
