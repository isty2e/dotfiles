# Non-interactive commands and jobs must not enter the interactive profile.
case $- in
    *i*) ;;
    *) return 0 ;;
esac

# A remote Linux session enters Zsh before loading Bash-only settings.
_dotfiles_shell_dir="$HOME/.config/dotfiles/shell"
if [ -r "$_dotfiles_shell_dir/bash-handoff.sh" ]; then
    # shellcheck source=/dev/null
    . "$_dotfiles_shell_dir/bash-handoff.sh"
fi

# Machine settings precede tool activation and interactive features.
for _dotfiles_file in local-loader.sh plugin-paths.sh platform.sh common.sh environment.sh \
    bash-history.sh bash-completion.sh prompt.sh; do
    if [ -r "$_dotfiles_shell_dir/$_dotfiles_file" ]; then
        # shellcheck source=/dev/null
        . "$_dotfiles_shell_dir/$_dotfiles_file"
    fi
done
unset _dotfiles_file _dotfiles_shell_dir
