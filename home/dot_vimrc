" Fixed Colemak roles; native operator and literal-input grammars stay separate.
for s:mode in ['n', 'x']
  for [s:from, s:to] in [
        \ ['n', 'gj'], ['e', 'gk'], ['j', 'e'], ['k', 'n'],
        \ ['gj', 'j'], ['gk', 'k'], ['u', 'i'], ['l', 'u'], ['i', 'l'],
        \ ['J', 'E'], ['N', 'J'], ['K', 'N'], ['E', 'K']]
    execute s:mode . 'noremap ' . s:from . ' ' . s:to
  endfor
endfor

