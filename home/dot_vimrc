let s:window_bindings = [
      \ ['j', '<Nop>'], ['n', '<C-w>j'], ['k', '<C-w>n'], ['e', '<C-w>k'],
      \ ['i', '<C-w>l'], ['l', '<C-w>i'],
      \ ['J', '<Nop>'], ['N', '<C-w>J'], ['K', '<Nop>'], ['E', '<C-w>K'],
      \ ['I', '<C-w>L'], ['L', '<C-w>I']]
for s:mode in ['n', 'x']
  for [s:from, s:to] in s:window_bindings
    execute s:mode . 'noremap <C-w>' . s:from . ' ' . s:to
    if s:from =~# '^[a-z]$'
      execute s:mode . 'noremap <C-w><C-' . s:from . '> ' . s:to
    endif
  endfor
endfor
unlet s:mode s:from s:to s:window_bindings
