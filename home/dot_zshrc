[[ -o interactive ]] || return 0
export DOTFILES_ZSH_ACTIVE=1

# Bootstrap tools may be installed before mise is active.
case :$PATH: in
    *:"$HOME/.local/bin":*) ;;
    *) export PATH="$HOME/.local/bin:$PATH" ;;
esac

_dotfiles_shell_dir="$HOME/.config/shell"

# Ordinary preferences are defaults, not overrides of device settings.
HISTSIZE=4096
SAVEHIST=4096
HISTFILE="${HISTFILE:-$HOME/.zsh_history}"
setopt append_history hist_ignore_all_dups hist_expire_dups_first share_history
setopt always_to_end complete_in_word extendedglob glob_complete
setopt auto_cd auto_remove_slash chase_links list_rows_first
unsetopt correct

# OS defaults, then this device's overrides.
if [[ -r $_dotfiles_shell_dir/platforms/init.sh ]]; then
    source "$_dotfiles_shell_dir/platforms/init.sh"
fi
if [[ -r $_dotfiles_shell_dir/device.sh ]]; then
    source "$_dotfiles_shell_dir/device.sh"
fi

# Shared preferences and existing tools; none of these installs software.
if [[ -r $_dotfiles_shell_dir/generation.sh ]]; then
    source "$_dotfiles_shell_dir/generation.sh"
fi
if [[ -r $_dotfiles_shell_dir/integrations/homebrew.sh ]]; then
    source "$_dotfiles_shell_dir/integrations/homebrew.sh"
fi
if [[ -r $_dotfiles_shell_dir/preferences.sh ]]; then
    source "$_dotfiles_shell_dir/preferences.sh"
fi
if [[ -r $_dotfiles_shell_dir/integrations/slurm.sh ]]; then
    source "$_dotfiles_shell_dir/integrations/slurm.sh"
fi
if [[ -r $_dotfiles_shell_dir/integrations/environment.sh ]]; then
    source "$_dotfiles_shell_dir/integrations/environment.sh"
fi

if [[ -r $_dotfiles_shell_dir/zsh/plugins.zsh ]]; then
    source "$_dotfiles_shell_dir/zsh/plugins.zsh"
fi
if [[ -r $_dotfiles_shell_dir/integrations/prompt.sh ]]; then
    source "$_dotfiles_shell_dir/integrations/prompt.sh"
fi
unset _dotfiles_shell_dir
