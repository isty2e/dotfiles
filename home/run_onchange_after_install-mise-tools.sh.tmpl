#!/bin/sh
set -eu

# mise declaration: {{ include "private_dot_config/mise/config.toml" | sha256sum }}
mise_bin=$(command -v mise || :)
if [ -z "$mise_bin" ]; then
    mise_bin="$HOME/.local/bin/mise"
fi
if [ ! -x "$mise_bin" ]; then
    printf '%s\n' 'mise is required; run the checkout bootstrap.sh first.' >&2
    exit 1
fi

export MISE_GLOBAL_CONFIG_FILE="$CHEZMOI_DEST_DIR/.config/mise/config.toml"
exec "$mise_bin" --cd "$CHEZMOI_DEST_DIR" install
