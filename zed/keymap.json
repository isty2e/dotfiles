[
  // Object-selector keys keep their native meaning; the outer inner-object key moves to u.
  {
    "context": "VimControl && !menu && !(vim_operator == a || vim_operator == i || vim_operator == cs || vim_operator == helix_next || vim_operator == helix_previous)",
    "bindings": {
      "n": [
        "vim::Down",
        {
          "display_lines": true
        }
      ],
      "e": [
        "vim::Up",
        {
          "display_lines": true
        }
      ],
      "j": "vim::NextWordEnd",
      "g j": "vim::Down",
      "k": "vim::MoveToNextMatch",
      "g k": "vim::Up",
      "u": [
        "vim::PushObject",
        {
          "around": false
        }
      ],
      "i": "vim::Right",
      "l": null,
      "shift-j": [
        "vim::NextWordEnd",
        {
          "ignore_punctuation": true
        }
      ],
      "shift-n": null,
      "shift-k": "vim::MoveToPreviousMatch",
      "shift-e": "editor::Hover",
      "shift-i": "vim::WindowBottom",
      "shift-u": null,
      "shift-l": null
    }
  },
  // History cycles follow each native mode; Visual retains case conversion.
  {
    "context": "(vim_mode == normal || vim_mode == helix_normal) && !menu",
    "bindings": {
      "l": "vim::Undo",
      "shift-n": "vim::JoinLines",
      "shift-u": "vim::InsertFirstNonWhitespace"
    }
  },
  {
    "context": "vim_mode == normal && !menu",
    "bindings": {
      "u": "vim::InsertBefore",
      "ctrl-r": "vim::UndoLastLine",
      "shift-l": "vim::Redo"
    }
  },
  {
    "context": "vim_mode == visual && !menu",
    "bindings": {
      "l": "vim::ConvertToLowerCase",
      "shift-n": "vim::JoinLines",
      "shift-u": "vim::InsertBefore",
      "shift-l": "vim::ConvertToUpperCase"
    }
  },
  {
    "context": "vim_mode == helix_select && !menu",
    "bindings": {
      "u": "vim::InsertBefore",
      "l": "vim::Undo",
      "shift-n": "vim::JoinLines"
    }
  },
  {
    "context": "VimControl && vim_mode == helix_normal && !menu && !BufferSearchBar",
    "bindings": {
      "u": "vim::HelixInsert"
    }
  },
  {
    "context": "(vim_mode == helix_normal || vim_mode == helix_select) && !menu",
    "bindings": {
      "i": "vim::WrappingRight",
      "k": "vim::HelixSelectNext",
      "shift-k": "vim::HelixSelectPrevious",
      "shift-i": "pane::ActivateNextItem",
      "shift-l": "editor::Redo",
      "g n": "vim::Down",
      "g e": "vim::Up",
      "g j": "vim::EndOfDocument",
      "g k": "pane::ActivateNextItem",
      "g i": "vim::EndOfLine",
      "g u": "editor::GoToImplementation",
      "g l": "git::StageAndNext",
      "space w n": "workspace::ActivatePaneDown",
      "space w e": "workspace::ActivatePaneUp",
      "space w i": "workspace::ActivatePaneRight",
      "space w j": null,
      "space w k": null,
      "space w l": null
    }
  },
  {
    "context": "vim_operator == d && !menu",
    "bindings": {
      "l": "git::StageAndNext",
      "shift-l": "git::UnstageAndNext"
    }
  },
  {
    "context": "vim_operator == gu && !menu",
    "bindings": {
      "l": "vim::CurrentLine"
    }
  },
  {
    "context": "vim_operator == gU && !menu",
    "bindings": {
      "shift-l": "vim::CurrentLine"
    }
  },
  {
    "context": "VimControl && !menu || !Editor && !Terminal",
    "bindings": {
      "ctrl-w n": "workspace::ActivatePaneDown",
      "ctrl-w k": "workspace::NewFileSplitHorizontal",
      "ctrl-w e": "workspace::ActivatePaneUp",
      "ctrl-w i": "workspace::ActivatePaneRight",
      "ctrl-w j": null,
      "ctrl-w l": null,
      "ctrl-w ctrl-n": "workspace::ActivatePaneDown",
      "ctrl-w ctrl-k": "workspace::NewFileSplitHorizontal",
      "ctrl-w ctrl-e": "workspace::ActivatePaneUp",
      "ctrl-w ctrl-i": "workspace::ActivatePaneRight",
      "ctrl-w ctrl-j": null,
      "ctrl-w ctrl-l": null,
      "ctrl-w shift-n": "workspace::MovePaneDown",
      "ctrl-w shift-e": "workspace::MovePaneUp",
      "ctrl-w shift-i": "workspace::MovePaneRight",
      "ctrl-w shift-j": null,
      "ctrl-w shift-k": null,
      "ctrl-w shift-l": null
    }
  },
  {
    "context": "Editor && mode == auto_height && VimControl && !menu && !(vim_operator == a || vim_operator == i || vim_operator == cs || vim_operator == helix_next || vim_operator == helix_previous)",
    "bindings": {
      "k": null,
      "shift-k": null
    }
  },
  {
    "context": "Editor && vim_mode == normal && !VimWaiting && !menu",
    "bindings": {
      ", .": "pane::ActivateNextItem",
      ", m": "pane::ActivatePreviousItem"
    }
  },
  {
    "context": "Editor && vim_mode == helix_normal && !VimWaiting && !menu",
    "bindings": {
      ", .": "pane::ActivateNextItem",
      ", m": "pane::ActivatePreviousItem"
    }
  },
  // Preserve the existing popup gesture outside this modal-mode rewrite.
  {
    "context": "showing_completions",
    "bindings": {
      "ctrl-j": "vim::LineDown"
    }
  },
  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      "n": "vim::MenuSelectNext",
      "e": "vim::MenuSelectPrevious",
      "i": "project_panel::ExpandSelectedEntry",
      "j": null,
      "k": null,
      "l": null
    }
  },
  {
    "context": "OutlinePanel && not_editing",
    "bindings": {
      "n": "vim::MenuSelectNext",
      "e": "vim::MenuSelectPrevious",
      "i": "outline_panel::ExpandSelectedEntry",
      "j": null,
      "k": null,
      "l": null
    }
  },
  {
    "context": "GitPanel && (ChangesList || HistoryList) && !GitBranchSelector && !GitRepositorySelector",
    "use_key_equivalents": true,
    "bindings": {
      "n": "menu::SelectNext",
      "e": "menu::SelectPrevious",
      "j": null,
      "k": null
    }
  },
  {
    "context": "GitPanel && ChangesList && !GitBranchSelector && !GitRepositorySelector",
    "use_key_equivalents": true,
    "bindings": {
      "i": "git_panel::ExpandSelectedEntry",
      "u": "git_panel::FocusEditor",
      "l": null
    }
  },
  {
    "context": "Picker > Editor",
    "bindings": {
      "ctrl-l": "editor::DeleteToBeginningOfLine"
    }
  },
  {
    "context": "GitGraph && !GitGraphSearchBar",
    "bindings": {
      "n": "vim::MenuSelectNext",
      "e": "vim::MenuSelectPrevious",
      "j": null,
      "k": null
    }
  },
  {
    "context": "SettingsWindow > NavigationMenu && !search",
    "bindings": {
      "n": "settings_editor::FocusNextNavEntry",
      "e": "settings_editor::FocusPreviousNavEntry",
      "i": "settings_editor::ExpandNavEntry",
      "j": null,
      "k": null,
      "l": null
    }
  },
  {
    "context": "FileHistoryView",
    "bindings": {
      "n": "menu::SelectNext",
      "e": "menu::SelectPrevious",
      "j": null,
      "k": null
    }
  },
  {
    "context": "NotebookEditor && notebook_mode == command",
    "bindings": {
      "n": "menu::SelectNext",
      "e": "menu::SelectPrevious",
      "u": "notebook::EnterEditMode",
      "j": null,
      "k": null,
      "i": null
    }
  },
  {
    "context": "ThreadsSidebar && !Editor",
    "bindings": {
      "n": "menu::SelectNext",
      "e": "menu::SelectPrevious",
      "i": "menu::SelectChild",
      "j": null,
      "k": null,
      "l": null
    }
  },
  {
    "context": "os == macos && Prompt",
    "use_key_equivalents": true,
    "bindings": {
      "i": "menu::SelectNext",
      "l": null
    }
  },
  {
    "context": "os != macos && Prompt",
    "bindings": {
      "i": "menu::SelectNext",
      "l": null
    }
  },
  // Specialized Editor rules follow generic modal bindings and retain native display aliases.
  {
    "context": "NotebookEditor > Editor && VimControl && vim_mode == normal && !menu",
    "bindings": {
      "n": "notebook::NotebookMoveDown",
      "e": "notebook::NotebookMoveUp",
      "g j": [
        "vim::Down",
        {
          "display_lines": true
        }
      ],
      "g k": [
        "vim::Up",
        {
          "display_lines": true
        }
      ]
    }
  },
  {
    "context": "ThreadsSidebar > Editor && VimControl && vim_mode == normal && !menu",
    "bindings": {
      "n": "editor::MoveDown",
      "e": "editor::MoveUp",
      "g j": [
        "vim::Down",
        {
          "display_lines": true
        }
      ],
      "g k": [
        "vim::Up",
        {
          "display_lines": true
        }
      ]
    }
  }
]
